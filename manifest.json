{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_extName__",
  "version": "0.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "debugger",
    "tabs",
    "storage",
    "scripting",
    "downloads"
